# Documentation only: .NET does not automatically load this file.
# Use docs/http-quickstart.md to generate three independent tokens at runtime.
# Do not use these empty values as credentials; the host fails closed.
APS_DDA_EXECUTOR_TOKEN=
APS_DDA_APPROVER_TOKEN=
APS_DDA_READER_TOKEN=

# Explicit development-only HTTP exception. Never expose this sample publicly.
DOTNET_ENVIRONMENT=Development
APS_DDA_ALLOW_LOOPBACK_HTTP=true
ASPNETCORE_URLS=http://localhost:5127
# Choose a fresh file per host process; existing databases are refused.
# APS_DDA_DATABASE=/your/private/temp-directory/runtime.sqlite
